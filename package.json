{
  "name": "disk-maintenance",
  "version": "1.0.0",
  "description": "Disk Intelligence - Full stack disk maintenance tool",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm:dev:frontend\" \"npm:dev:backend\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "python3 backend/main.py",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "install-all": "npm --prefix frontend install && pip install -r backend/requirements.txt",
    "dist": "npm --prefix frontend run dist",
    "dist:win": "npm --prefix frontend run dist:win",
    "dist:mac": "npm --prefix frontend run dist:mac"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0"
  }
}

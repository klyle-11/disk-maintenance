{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Disk Intelligence",
  "version": "1.0.0",
  "identifier": "com.disk-intelligence.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5176",
    "beforeDevCommand": "npm run dev:vite",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Disk Intelligence",
        "width": 1280,
        "height": 800,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Find what is eating your disk",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "../../backend/diskcli/": "diskcli/"
    },
    "linux": {
      "deb": { "depends": ["python3"] }
    }
  }
}
